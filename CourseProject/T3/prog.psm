; CourseProject T3 — Heart Rate Measurement via Arduino JC1 pulse timing
; Detects rising edges from Arduino on JC1, measures period in ms,
; computes BPM = 6000 / period_10ms, outputs ASCII digits to OLED.
;
; Port map:
;   INPUT  0x00 : XADC high byte (8 MSBs) — output to LEDs for debug
;   INPUT  0x01 : ms-timer low  byte
;   INPUT  0x02 : ms-timer high byte
;   INPUT  0x03 : peak-detected flag (bit 0, cleared by reading)
;   OUTPUT 0x00 : led[7:0]  (raw XADC for debugging)
;   OUTPUT 0x01 : BPM tens  digit ASCII
;   OUTPUT 0x02 : BPM units digit ASCII

CONSTANT xadc_port,   00
CONSTANT timer_lo,    01
CONSTANT timer_hi,    02
CONSTANT peak_port,   03
CONSTANT led_port,    00
CONSTANT bpm_tens_p,  01
CONSTANT bpm_units_p, 02

; Scratchpad memory locations
CONSTANT prev_lo,     00   ; previous peak timestamp low byte
CONSTANT prev_hi,     01   ; previous peak timestamp high byte
CONSTANT bpm_val,     02   ; last computed BPM

; ─────────────────────────────────────────────────────────────────────────
ADDRESS 000
start:
    ; Initialize OLED display to '--'
    LOAD s0, 2D                  ; ASCII '-'
    OUTPUT s0, bpm_tens_p
    OUTPUT s0, bpm_units_p

    ; Clear scratchpad
    LOAD s0, 00
    STORE s0, prev_lo
    STORE s0, prev_hi
    STORE s0, bpm_val

main_loop:
    ; ── Mirror raw XADC onto LEDs ────────────────────────────────────────
    INPUT  s0, xadc_port
    OUTPUT s0, led_port

    ; ── Poll for Arduino heartbeat pulse ─────────────────────────────────
    INPUT s1, peak_port
    TEST  s1, 01
    JUMP  Z, main_loop           ; no new peak -> keep polling

    ; ── New peak — read current ms timestamp ─────────────────────────────
    INPUT sA, timer_lo
    INPUT sB, timer_hi

    ; Read previous timestamp from scratchpad
    FETCH sC, prev_lo
    FETCH sD, prev_hi

    ; period = current - previous  (16-bit subtraction, wraps correctly)
    SUB   sA, sC
    SUBCY sB, sD
    ; sB:sA = inter-beat period in ms

    ; Store new timestamp for next beat
    INPUT sC, timer_lo
    INPUT sD, timer_hi
    STORE sC, prev_lo
    STORE sD, prev_hi

    ; ── Compute BPM = 6000 / period_ms ───────────────────────────────────
    ; If high byte sB > 0, period > 255 ms => BPM < ~24, show '--'
    COMPARE sB, 00
    JUMP NZ, very_slow

    ; Convert to 10ms units: period_10ms = period_ms / 10 (iterative)
    LOAD  sE, 00                 ; quotient
    LOAD  sF, sA                 ; working copy of period_ms
div10_loop:
    COMPARE sF, 0A               ; sF >= 10?
    JUMP C, div10_done           ; carry set means sF < 10, done
    ADD   sE, 01
    SUB   sF, 0A
    JUMP  div10_loop
div10_done:
    ; sE = period_10ms

    COMPARE sE, 00
    JUMP Z, very_slow            ; period < 10 ms = physiologically impossible

    ; BPM = 6000 / period_10ms  using iterative 16-bit subtraction
    ; 6000 decimal = 0x1770  (s2=low, s3=high, s4=accumulator)
    LOAD s2, 70
    LOAD s3, 17
    LOAD s4, 00                  ; BPM accumulator

bpm_loop:
    COMPARE s3, 00
    JUMP NZ, bpm_sub             ; high byte non-zero -> dividend still >= divisor
    COMPARE s2, sE
    JUMP C, bpm_done             ; s2 < sE -> done
bpm_sub:
    ADD   s4, 01
    SUB   s2, sE
    SUBCY s3, 00
    JUMP  bpm_loop
bpm_done:
    ; s4 = BPM (max 255)
    STORE s4, bpm_val

    ; Clamp to 200
    COMPARE s4, C8               ; 200 = 0xC8
    JUMP C, no_clamp
    LOAD s4, C8
no_clamp:

    ; ── Convert BPM to two ASCII digits (tens + units) ───────────────────
    LOAD s5, 30                  ; tens digit starts at '0'
    LOAD s6, s4                  ; working copy

    ; Handle 100+ range
    COMPARE s6, 64               ; 100 = 0x64
    JUMP C, under100
    SUB   s6, 64
    LOAD  s5, 31                 ; hundreds = 1, so tens base = '1'
    JUMP  tens_loop
under100:
    LOAD  s5, 30

tens_loop:
    COMPARE s6, 0A
    JUMP C, tens_done
    ADD   s5, 01
    SUB   s6, 0A
    JUMP  tens_loop
tens_done:
    ; s5 = tens ASCII, s6 = units value
    ADD s6, 30                   ; convert units to ASCII

    OUTPUT s5, bpm_tens_p
    OUTPUT s6, bpm_units_p

    JUMP main_loop

very_slow:
    ; Signal too slow or no sensor — show '--'
    LOAD s0, 2D
    OUTPUT s0, bpm_tens_p
    OUTPUT s0, bpm_units_p
    JUMP main_loop

; ─────────────────────────────────────────────────────────────────────────
ADDRESS 3FF
    JUMP start
