; CourseProject T3 — Heart Rate Measurement via Arduino JC1 pulse timing
; Detects rising edges from Arduino on JC1, measures inter-beat period,
; computes BPM = 6000 / period_10ms, outputs ASCII digits to OLED.
;
; Port map:
;   INPUT  0x00 : XADC high byte (8 MSBs) — mirror to LEDs for debug
;   INPUT  0x01 : ms-timer low  byte
;   INPUT  0x02 : ms-timer high byte
;   INPUT  0x03 : peak-detected flag (bit 0, cleared by reading)
;   OUTPUT 0x00 : led[7:0]  (raw XADC for debug)
;   OUTPUT 0x01 : BPM tens  digit ASCII
;   OUTPUT 0x02 : BPM units digit ASCII
;
; Register map:
;   s0        scratch / XADC byte
;   s1        peak flag
;   s2        scratch / div temp
;   s3-s4     BPM 16-bit dividend (s3=lo, s4=hi)  then BPM result in s3
;   s5        tens ASCII digit
;   s6        working copy for digit conversion
;   sA        current timestamp low  / period low
;   sB        current timestamp high / period high
;   sC        previous timestamp low
;   sD        previous timestamp high
;   sE        period_10ms (quotient of period/10)
;
; Scratchpad:
;   0x00  prev_lo   — previous peak timestamp low byte
;   0x01  prev_hi   — previous peak timestamp high byte
;   0x03  has_prev  — 0=no previous sample yet, 1=valid

CONSTANT xadc_port,   00
CONSTANT timer_lo,    01
CONSTANT timer_hi,    02
CONSTANT peak_port,   03
CONSTANT led_port,    00
CONSTANT bpm_tens_p,  01
CONSTANT bpm_units_p, 02

CONSTANT prev_lo,     00
CONSTANT prev_hi,     01
CONSTANT has_prev,    03

; ─────────────────────────────────────────────────────────────────────────
ADDRESS 000
start:
    LOAD s0, 2D                   ; ASCII '-'
    OUTPUT s0, bpm_tens_p
    OUTPUT s0, bpm_units_p
    LOAD s0, 00
    STORE s0, prev_lo
    STORE s0, prev_hi
    STORE s0, has_prev             ; no previous sample yet

main_loop:
    INPUT  s0, xadc_port
    OUTPUT s0, led_port

    INPUT  s1, peak_port
    TEST   s1, 01
    JUMP   Z, main_loop            ; no new peak

    ; Read current timestamp
    INPUT  sA, timer_lo
    INPUT  sB, timer_hi

    ; First beat: just record timestamp, can't compute period yet
    FETCH  s2, has_prev
    COMPARE s2, 00
    JUMP   Z, first_beat

    ; Load previous timestamp
    FETCH  sC, prev_lo
    FETCH  sD, prev_hi

    ; Save current timestamp as new previous BEFORE subtracting
    STORE  sA, prev_lo
    STORE  sB, prev_hi

    ; period_ms = current - previous  (16-bit, wraps correctly)
    SUB    sA, sC
    SUBCY  sB, sD
    ; sB:sA = inter-beat period in milliseconds

    ; ── Divide period_ms by 10 → sE (16-bit iterative) ──────────────────
    LOAD   sE, 00

div10_loop:
    COMPARE sB, 00
    JUMP   NZ, div10_sub           ; sB != 0 → sB:sA definitely >= 10
    COMPARE sA, 0A
    JUMP   C, div10_done           ; sA < 10 and sB == 0 → done
div10_sub:
    SUB    sA, 0A
    SUBCY  sB, 00
    ADD    sE, 01
    COMPARE sE, 00                 ; wrapped → period > 2550 ms (< 24 BPM)
    JUMP   Z, very_slow
    JUMP   div10_loop
div10_done:

    ; sE = period_10ms;  reject if 0 (period < 10 ms, impossible)
    COMPARE sE, 00
    JUMP   Z, very_slow

    ; ── BPM = 6000 / period_10ms  (16-bit iterative) ────────────────────
    ; 6000 = 0x1770  →  s3=0x70 (lo), s4=0x17 (hi),  s2=accumulator
    LOAD   s3, 70
    LOAD   s4, 17
    LOAD   s2, 00                  ; BPM accumulator

bpm_loop:
    COMPARE s4, 00
    JUMP   NZ, bpm_sub             ; high byte != 0 → dividend >= divisor
    COMPARE s3, sE
    JUMP   C, bpm_done             ; s3 < sE → done
bpm_sub:
    ADD    s2, 01
    SUB    s3, sE
    SUBCY  s4, 00
    JUMP   bpm_loop
bpm_done:
    ; s2 = BPM; clamp to 200 (0xC8)
    COMPARE s2, C8
    JUMP   C, no_clamp
    LOAD   s2, C8
no_clamp:

    ; ── Convert BPM to tens + units ASCII digits ─────────────────────────
    LOAD   s5, 30                  ; tens digit ('0')
    LOAD   s6, s2                  ; working copy of BPM

    ; Handle 100–199
    COMPARE s6, 64                 ; 100 = 0x64
    JUMP   C, under100
    SUB    s6, 64
    LOAD   s5, 31                  ; '1'
    JUMP   tens_loop
under100:
    LOAD   s5, 30                  ; '0'

tens_loop:
    COMPARE s6, 0A
    JUMP   C, tens_done
    ADD    s5, 01
    SUB    s6, 0A
    JUMP   tens_loop
tens_done:
    ADD    s6, 30                  ; units value → ASCII

    OUTPUT s5, bpm_tens_p
    OUTPUT s6, bpm_units_p
    JUMP   main_loop

first_beat:
    STORE  sA, prev_lo
    STORE  sB, prev_hi
    LOAD   s2, 01
    STORE  s2, has_prev
    JUMP   main_loop

very_slow:
    LOAD   s0, 2D
    OUTPUT s0, bpm_tens_p
    OUTPUT s0, bpm_units_p
    JUMP   main_loop

; ─────────────────────────────────────────────────────────────────────────
ADDRESS 3FF
    JUMP start
