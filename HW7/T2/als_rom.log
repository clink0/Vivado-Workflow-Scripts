 006                       ;=========================================================
 006                       ; routine: init - set LEDs all on at startup
 006                       ;=========================================================
 006                 init: 
 006  010FF                LOAD s0[led_lsb], FF
 007  011FF                LOAD s1[led_msb], FF
 008  2D000                OUTPUT s0[led_lsb], 00[led_lsb_port]
 009  2D101                OUTPUT s1[led_msb], 01[led_msb_port]
 00A  25000                RETURN 
