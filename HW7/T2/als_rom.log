 000                       ;=========================================================
 000                       ; HW7 T2 - Smart Light Controller
 000                       ; Reads 8-bit ambient light value from SPI ALS sensor.
 000                       ; Brighter room = fewer LEDs on.
 000                       ; Darker room   = more LEDs on (all 16 at minimum light).
 000                       ;
 000                       ; Port map:
 000                       ;   IN  0x00: {7'b0, spi_ready} - SPI data ready flag
 000                       ;   IN  0x01: light[7:0]        - 8-bit light value
 000                       ;   OUT 0x00: led[7:0]
 000                       ;   OUT 0x01: led[15:8]
 000                       ;=========================================================
 000                       ;=========================================================
 000                       ; Register alias
 000                       ;=========================================================
 000                       NAMEREG s0, led_lsb                  ; lower byte of LED pattern
 000                       NAMEREG s1, led_msb                  ; upper byte of LED pattern
 000                       NAMEREG s2, light_val                ; raw light reading
 000                       NAMEREG s3, n                        ; shift count (light >> 4)
 000                       NAMEREG s4, tmp
 000                       ;=========================================================
 000                       ; Port alias
 000                       ;=========================================================
 000                       CONSTANT ready_port, 00
 000                       CONSTANT light_port, 01
 000                       CONSTANT led_lsb_port, 00
 000                       CONSTANT led_msb_port, 01
