 011                       ; routine: compute_leds
 011                       ;   n = light_val >> 4  (0-15, how many LEDs to turn OFF)
 011                       ;   Start with led_msb:led_lsb = 0xFFFF (all 16 on)
 011                       ;   Shift right n times: each shift clears one LED from MSB side
 011                       ;=========================================================
 011         compute_leds: 
 011  011FF                LOAD s1[led_msb], FF
 012  010FF                LOAD s0[led_lsb], FF
 013  00320                LOAD s3[n], s2[light_val]
 014                       ; n = light_val >> 4
 014  1430E                SR0 s3[n]
 015  1430E                SR0 s3[n]
 016  1430E                SR0 s3[n]
 017  1430E                SR0 s3[n]
 018                       ; now n = upper nibble of light_val (0-15)
 018  1D300                COMPARE s3[n], 00
 019  3201E                JUMP Z, 01E[leds_done]
 01A           shift_loop: 
 01A                       ; shift {led_msb, led_lsb} right by 1, inserting 0 at MSB
 01A  1410E                SR0 s1[led_msb]
 01B  14008                SRA s0[led_lsb]
 01C  19301                SUB s3[n], 01
 01D  3601A                JUMP NZ, 01A[shift_loop]
 01E            leds_done: 
 01E  25000                RETURN 
