                  ;=========================================================
                  ; Square circuit with 7-seg LED interface
                  ; Lab 8 T1 - Basys 3 / KCPSM6 version
                  ;=========================================================
                  ; Program operation:
                  ;  - read a and b from switch (via btnR)
                  ;  - btnL clears and re-initializes
                  ;  - calculate a*a + b*b
                  ;  - display data on 7-seg LED based on sw[2:0]:
                  ;      000: a
                  ;      001: b
                  ;      010: a^2
                  ;      011: b^2
                  ;      100: a^2+b^2
                  ;
                  ; 7-seg patterns are Basys 3 format: {dp, g, f, e, d, c, b, a} active-low
                  ;=========================================================
                  ; Data ram address alias
                  ;=========================================================
                  CONSTANT a_lsb, 00
                  CONSTANT b_lsb, 02
                  CONSTANT aa_lsb, 04
                  CONSTANT aa_msb, 05
                  CONSTANT bb_lsb, 06
                  CONSTANT bb_msb, 07
                  CONSTANT aabb_lsb, 08
                  CONSTANT aabb_msb, 09
                  CONSTANT aabb_cout, 0A
                  CONSTANT led0, 10
                  CONSTANT led1, 11
                  CONSTANT led2, 12
                  CONSTANT led3, 13
                  ;=========================================================
                  ; Register alias
                  ;=========================================================
                  NAMEREG s0, data          ; temporary data
                  NAMEREG s1, addr          ; temporary address
                  NAMEREG s2, i             ; loop index
                  NAMEREG sF, switch_a_b    ; ram offset (0=a, 2=b)
                  ;=========================================================
                  ; Port alias
                  ;=========================================================
                  CONSTANT rd_flag_port, 00 ; flags: {xxxxxxsc} c=btnL, s=btnR
                  CONSTANT sw_port, 01      ; 8-bit switch input
                  CONSTANT sseg0_port, 00   ; 7-seg digit 0 (rightmost)
                  CONSTANT sseg1_port, 01   ; 7-seg digit 1
                  CONSTANT sseg2_port, 02   ; 7-seg digit 2
                  CONSTANT sseg3_port, 03   ; 7-seg digit 3 (leftmost)
                  ;=========================================================
                  ; Main program
                  ;=========================================================
                  CALL init
         forever: 
                  CALL proc_btn
                  CALL square
                  CALL load_led_pttn
                  CALL disp_led
                  JUMP forever
                  ;=========================================================
                  ; routine: init
                  ;   clear data ram and switch_a_b register
                  ;=========================================================
            init: 
                  LOAD i, 40
                  LOAD data, 00
    clr_mem_loop: 
                  STORE data, (i)
                  SUB i, 01
                  JUMP NZ, clr_mem_loop
                  LOAD switch_a_b, 00
                  RETURN 
                  ;=========================================================
                  ; routine: proc_btn
                  ;   check btnL (clear) and btnR (store switch value)
                  ;=========================================================
        proc_btn: 
                  INPUT s3, rd_flag_port
                  TEST s3, 01               ; check btnL flag (bit 0)
                  JUMP Z, chk_btns
                  CALL init
                  JUMP proc_btn_done
        chk_btns: 
                  TEST s3, 02               ; check btnR flag (bit 1)
                  JUMP Z, proc_btn_done
                  INPUT data, sw_port
                  LOAD addr, a_lsb
                  ADD addr, switch_a_b
                  STORE data, (addr)
                  XOR switch_a_b, 02        ; toggle between a (00) and b (02)
   proc_btn_done: 
                  RETURN 
                  ;=========================================================
                  ; routine: load_led_pttn
                  ;   read sw[2:0], select value, build 4 hex digit patterns
                  ;=========================================================
   load_led_pttn: 
                  INPUT s6, sw_port
                  SL0 s6                    ; *2 for 2-byte address offset
                  COMPARE s6, 08            ; clamp to max offset 8
                  JUMP C, sw_ok
                  LOAD s6, 08
           sw_ok: 
                  LOAD addr, a_lsb
                  ADD addr, s6
                  FETCH data, (s6)
                  CALL get_lower_nibble
                  CALL hex_to_led
                  STORE data, led0
                  FETCH data, (addr)
                  CALL get_upper_nibble
                  CALL hex_to_led
                  STORE data, led1
                  ADD addr, 01
                  FETCH data, (addr)
                  CALL get_lower_nibble
                  CALL hex_to_led
                  STORE data, led2
                  FETCH data, (addr)
                  CALL get_upper_nibble
                  CALL hex_to_led
                  COMPARE s6, 08            ; displaying a^2+b^2?
                  JUMP NZ, led_done
                  ADD addr, 01
                  FETCH s6, (addr)
                  TEST s6, 01               ; carry=1?
                  JUMP Z, led_done
                  AND data, 7F              ; assert dp (bit 7 = 0 = on)
        led_done: 
                  STORE data, led3
                  RETURN 
                  ;=========================================================
                  ; routine: disp_led
                  ;   output 4 patterns to 7-seg ports
                  ;=========================================================
        disp_led: 
                  FETCH data, led0
                  OUTPUT data, sseg0_port
                  FETCH data, led1
                  OUTPUT data, sseg1_port
                  FETCH data, led2
                  OUTPUT data, sseg2_port
                  FETCH data, led3
                  OUTPUT data, sseg3_port
                  RETURN 
                  ;=========================================================
                  ; routine: hex_to_led
                  ;   convert hex nibble (0-F) to Basys 3 7-seg pattern
                  ;   Basys 3 format: {dp, g, f, e, d, c, b, a} active-low
                  ;   dp=1 (off) for all digits
                  ;=========================================================
      hex_to_led: 
                  COMPARE data, 00
                  JUMP NZ, comp_hex_1
                  LOAD data, C0             ; 0: a,b,c,d,e,f on
                  JUMP hex_done
      comp_hex_1: 
                  COMPARE data, 01
                  JUMP NZ, comp_hex_2
                  LOAD data, F9             ; 1: b,c on
                  JUMP hex_done
      comp_hex_2: 
                  COMPARE data, 02
                  JUMP NZ, comp_hex_3
                  LOAD data, A4             ; 2: a,b,d,e,g on
                  JUMP hex_done
      comp_hex_3: 
                  COMPARE data, 03
                  JUMP NZ, comp_hex_4
                  LOAD data, B0             ; 3: a,b,c,d,g on
                  JUMP hex_done
      comp_hex_4: 
                  COMPARE data, 04
                  JUMP NZ, comp_hex_5
                  LOAD data, 99             ; 4: b,c,f,g on
                  JUMP hex_done
      comp_hex_5: 
                  COMPARE data, 05
                  JUMP NZ, comp_hex_6
                  LOAD data, 92             ; 5: a,c,d,f,g on
                  JUMP hex_done
      comp_hex_6: 
                  COMPARE data, 06
                  JUMP NZ, comp_hex_7
                  LOAD data, 82             ; 6: a,c,d,e,f,g on
                  JUMP hex_done
      comp_hex_7: 
                  COMPARE data, 07
                  JUMP NZ, comp_hex_8
                  LOAD data, F8             ; 7: a,b,c on
                  JUMP hex_done
      comp_hex_8: 
                  COMPARE data, 08
                  JUMP NZ, comp_hex_9
                  LOAD data, 80             ; 8: all on
                  JUMP hex_done
      comp_hex_9: 
                  COMPARE data, 09
                  JUMP NZ, comp_hex_a
                  LOAD data, 90             ; 9: a,b,c,d,f,g on
                  JUMP hex_done
      comp_hex_a: 
                  COMPARE data, 0A
                  JUMP NZ, comp_hex_b
                  LOAD data, 88             ; A: a,b,c,e,f,g on
                  JUMP hex_done
      comp_hex_b: 
                  COMPARE data, 0B
                  JUMP NZ, comp_hex_c
                  LOAD data, 83             ; b: c,d,e,f,g on
                  JUMP hex_done
      comp_hex_c: 
                  COMPARE data, 0C
                  JUMP NZ, comp_hex_d
                  LOAD data, C6             ; C: a,d,e,f on
                  JUMP hex_done
      comp_hex_d: 
                  COMPARE data, 0D
                  JUMP NZ, comp_hex_e
                  LOAD data, A1             ; d: b,c,d,e,g on
                  JUMP hex_done
      comp_hex_e: 
                  COMPARE data, 0E
                  JUMP NZ, comp_hex_f
                  LOAD data, 86             ; E: a,d,e,f,g on
                  JUMP hex_done
      comp_hex_f: 
                  LOAD data, 8E             ; F: a,e,f,g on
        hex_done: 
                  RETURN 
                  ;=========================================================
                  ; routine: get_lower_nibble
                  ;=========================================================
get_lower_nibble: 
                  AND data, 0F
                  RETURN 
                  ;=========================================================
                  ; routine: get_upper_nibble
                  ;=========================================================
get_upper_nibble: 
                  SR0 data
                  SR0 data
                  SR0 data
                  SR0 data
                  RETURN 
                  ;=========================================================
                  ; routine: square
                  ;   calculate a*a, b*b, a*a+b*b and store results in RAM
                  ;=========================================================
          square: 
                  FETCH s3, a_lsb
                  FETCH s4, a_lsb
                  CALL mult_soft
                  STORE s6, aa_lsb
                  STORE s5, aa_msb
                  FETCH s3, b_lsb
                  FETCH s4, b_lsb
                  CALL mult_soft
                  STORE s6, bb_lsb
                  STORE s5, bb_msb
                  FETCH data, aa_lsb
                  ADD data, s6
                  STORE data, aabb_lsb
                  FETCH data, aa_msb
                  ADDCY data, s5
                  STORE data, aabb_msb
                  LOAD data, 00
                  ADDCY data, 00
                  STORE data, aabb_cout
                  RETURN 
                  ;=========================================================
                  ; routine: mult_soft
                  ;   8-bit unsigned multiply: s3 * s4 -> {s5, s6}
                  ;=========================================================
       mult_soft: 
                  LOAD s5, 00
                  LOAD i, 08
       mult_loop: 
                  SR0 s4
                  JUMP NC, shift_prod
                  ADD s5, s3
      shift_prod: 
                  SRA s5
                  SRA s6
                  SUB i, 01
                  JUMP NZ, mult_loop
                  RETURN 
