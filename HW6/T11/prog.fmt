         ; Section 11 - Count number of switches that are ON, display count on LEDs
         ; Algorithm: test each bit of s0 one at a time, shift right 8 times
         ; s0 = switch input, s1 = count, s2 = loop counter (8 iterations)
         ; Compile: kcpsm6.exe prog.psm -> generates prog.v
FOREVER: 
         INPUT s0, 00  ; read switches from port 0
         LOAD s1, 00   ; clear bit count
         LOAD s2, 08   ; loop counter = 8 bits
   LOOP: 
         TEST s0, 01   ; test bit 0 of s0; Z=1 if bit is 0
         JUMP Z, SKIP  ; bit is 0, skip increment
         ADD s1, 01    ; bit is 1, increment count
   SKIP: 
         SR0 s0        ; shift s0 right 1 bit to check next bit
         SUB s2, 01    ; decrement loop counter
         JUMP NZ, LOOP ; if counter != 0, keep looping
         OUTPUT s1, 00 ; output count (0-8) to LEDs in binary
         JUMP FOREVER  ; repeat to update with new switch state
