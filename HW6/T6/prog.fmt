      ; Section 6 - Lower 2 bits of LEDs always ON regardless of switches
      ; mask = 0000_0011 forces bits 1:0 high via OR
      ; Compile: kcpsm6.exe prog.psm -> generates prog.v
      CONSTANT lowerMASK, 03 ; mask = 0000_0011
LOOP: INPUT s0, 00           ; read switches from port 0
      LOAD s1, s0            ; copy to s1
      OR s1, lowerMASK       ; set lower 2 bits to 1
      OUTPUT s1, 00          ; output to LEDs
      JUMP LOOP              ; repeat forever
