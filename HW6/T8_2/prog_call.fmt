         ; Section 8 - Same as prog.psm but using CALL instead of JUMP
         ; With CALL nz, the 'return' properly returns after TESTING.
         ; Result: if sw[0]=1 output 6 then 5 (both fire), else output 5 only.
         ; Compile: kcpsm6.exe prog_call.psm -> generates prog_call.v
         ; (update main_top.v to instantiate prog_call instead of prog)
FOREVER: 
         INPUT s0, 00     ; read switches
         LOAD s2, 05      ; s2 = 5
         LOAD s3, 06      ; s3 = 6
         LOAD s1, s0      ; copy switches to s1
         TEST s1, 01      ; test bit 0
         CALL NZ, TESTING ; if bit 0 = 1, call TESTING subroutine
         OUTPUT s2, 00    ; always runs after call returns (or when bit 0 = 0)
         JUMP FOREVER
TESTING: 
         OUTPUT s3, 00    ; bit 0 = 1: output 6
         RETURN           ; return to instruction after call (output s2)
