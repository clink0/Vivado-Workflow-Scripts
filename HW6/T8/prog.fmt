         ; Section 8 - jump/return/load: if sw[0]=1 output 6, else output 5
         ; Using JUMP nz - the 'return' in TESTING has no effect because
         ; jump does not push to the call stack. LEDs show 6 or 5.
         ; Compile: kcpsm6.exe prog.psm -> generates prog.v
FOREVER: 
         INPUT s0, 00     ; read switches
         LOAD s2, 05      ; s2 = 5
         LOAD s3, 06      ; s3 = 6
         LOAD s1, s0      ; copy switches to s1
         TEST s1, 01      ; test bit 0 (AND with 0x01)
         JUMP NZ, TESTING ; if bit 0 = 1, jump to TESTING
         OUTPUT s2, 00    ; bit 0 = 0: output 5 to LEDs
         JUMP FOREVER
TESTING: 
         OUTPUT s3, 00    ; bit 0 = 1: output 6 to LEDs
         RETURN           ; no effect with jump (stack was never pushed)
